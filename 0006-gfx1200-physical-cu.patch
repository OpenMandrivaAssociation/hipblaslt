 #include <stdexcept>
 
@@ -90,6 +92,23 @@
                 HIP_CHECK_EXC(hipDeviceGetAttribute(&prop.multiProcessorCount,
                                                     hipDeviceAttributePhysicalMultiProcessorCount,
                                                     deviceId));
+                // HIP WGP mode reports Physical as WGP count (half of rocminfo
+                // CUs). Tensile uses this as computeUnitCount for auto-GSU
+                // workspace and WGMXCCG. Restore CU = 2*WGP on gfx12.
+                if(std::strncmp(prop.gcnArchName, "gfx12", 5) == 0)
+                {
+                    int wgpCount = 0;
+                    HIP_CHECK_EXC(hipDeviceGetAttribute(
+                        &wgpCount, hipDeviceAttributeMultiprocessorCount, deviceId));
+                    if(wgpCount > 0 && prop.multiProcessorCount == wgpCount)
+                        prop.multiProcessorCount *= 2;
+                    if(const char* env = std::getenv("TENSILE_GFX12_CU_COUNT"))
+                    {
+                        int forced = std::atoi(env);
+                        if(forced > 0)
+                            prop.multiProcessorCount = forced;
+                    }
+                }
             }
 #endif
             return GetDevice(prop, deviceId);
